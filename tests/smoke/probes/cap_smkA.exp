#!/usr/bin/expect -f
set timeout 25
log_user 0
set stty_init "rows 30 columns 100"
log_file -a /tmp/caps.txt
spawn ssh -tt -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -p 2525 walker@127.0.0.1
expect { -re "Join World" {} timeout { exit 2 } }
send "1"
sleep 0.5
expect { -re "authenticating" {} timeout { exit 3 } }
expect { -re "the world" {} timeout { exit 4 } }
expect { -re "hp" {} timeout { exit 5 } }
send "j"
sleep 0.3
send "j"
sleep 0.5
send "i"
expect { -re "Inventory" { puts "INV_OK" } timeout { puts "INV_TIMEOUT"; exit 6 } }
send "\033"
sleep 0.5
send "\003"
expect eof
puts "DONE"
exit 0
